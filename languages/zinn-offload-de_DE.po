#. Plugin Name of the plugin
#: zinn-offload.php
msgid "Zinn® Media Offload"
msgstr "Zinn® Media Offload"

#. Plugin URI of the plugin
#: zinn-offload.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-offload"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-offload"

#. Description of the plugin
#: zinn-offload.php
msgid "Moves this site's media library to Zinn® object storage and serves it from a CDN. Configured from your Zinn® dashboard — no access key is ever typed into WordPress."
msgstr "Verschiebt die Mediathek dieser Website in den Zinn®-Objektspeicher und liefert sie von einem CDN aus. Konfiguriert über Ihr Zinn®-Dashboard – es muss nie ein Zugriffsschlüssel in WordPress eingegeben werden."

#. Author of the plugin
#: zinn-offload.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-offload.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

