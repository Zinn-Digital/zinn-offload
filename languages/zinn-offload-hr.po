msgstr "Svaki Zinn® dodatak na ovoj stranici i radi li on."

#: includes/class-zinn-offload-admin-ui.php:352
msgid "No connection is needed for this plugin."
msgstr "Za ovaj dodatak nije potrebna nikakva veza."

