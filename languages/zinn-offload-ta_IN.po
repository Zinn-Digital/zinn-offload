#. Plugin Name of the plugin
#: zinn-offload.php
msgid "Zinn® Media Offload"
msgstr "Zinn® Media Offload"

#. Plugin URI of the plugin
#: zinn-offload.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-offload"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-offload"

#. Description of the plugin
#: zinn-offload.php
msgid "Moves this site's media library to Zinn® object storage and serves it from a CDN. Configured from your Zinn® dashboard — no access key is ever typed into WordPress."
msgstr "இந்தத் தளத்தின் மீடியா நூலகத்தை Zinn® ஆப்ஜெக்ட் ஸ்டோரேஜaக்கு நகர்த்தி, அதை ஒரு CDN-இலிருந்து வழங்குகிறது. உங்கள் Zinn® டாஷ்போர்டிலிருந்து இது கட்டமைக்கப்படுகிறது — வேர்ட்பிரஸில் (WordPress) எந்த அணுகல் விசையும் (access key) தட்டச்சு செய்யப்படுவதில்லை."

#. Author of the plugin
#: zinn-offload.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-offload.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-zinn-offload-admin-fields.php:575
msgid "Stored. Type a new value to replace it."
msgstr "சேமிக்கப்பட்டது. அதை மாற்ற புதிய மதிப்பை உள்ளிடவும்."

#: includes/class-zinn-offload-admin-fields.php:635
msgid "Filter this list…"
msgstr "இந்த பட்டியலை வடிகட்டவும்…"

#: includes/class-zinn-offload-admin-fields.php:636
msgid "Filter this list"
msgstr "இந்த பட்டியலை வடிகட்டவும்"

#: includes/class-zinn-offload-admin-fields.php:652
msgid "Nothing matches that filter."
msgstr "அந்த வடிகட்டியுடன் எதுவும் பொருந்தவில்லை."

#: includes/class-zinn-offload-admin-fields.php:683
msgid "Add a row"
msgstr "வரி ஒன்றைச் சேர்"

#: includes/class-zinn-offload-admin-fields.php:720
msgid "Remove this row"
msgstr "இந்த வரியை அகற்று"

#: includes/class-zinn-offload-admin-fields.php:720
msgid "Remove"
msgstr "நீக்கு"

#: includes/class-zinn-offload-admin-ui.php:264
#: includes/class-zinn-offload-admin-ui.php:265
#: includes/class-zinn-offload-admin-ui.php:335
msgid "Zinn Digital®"
msgstr "Zinn Digital®"

#: includes/class-zinn-offload-admin-ui.php:278
msgid "Zinn Digital® — overview"
msgstr "Zinn Digital® — கண்ணோட்டம்"

#: includes/class-zinn-offload-admin-ui.php:279
msgid "Overview"
msgstr "கண்ணோட்டம்"

#: includes/class-zinn-offload-admin-ui.php:336
msgid "Every Zinn® plugin on this site, and whether it is working."
msgstr "இந்தத் தளத்தில் உள்ள ஒவ்வொரு Zinn® செருகுநிரலும், அது இயங்குகிறதா இல்லையா என்பதும்."

#: includes/class-zinn-offload-admin-ui.php:352
msgid "No connection is needed for this plugin."
msgstr "இந்த செருகுநிரலுக்கு எந்த இணைப்பும் தேவையில்லை."

#: includes/class-zinn-offload-admin-ui.php:357
msgid "Open settings"
msgstr "அமைப்புகளைத் திறக்கவும்"

#: includes/class-zinn-offload-admin-ui.php:685
#: includes/class-zinn-offload-admin-ui.php:1248
msgid "You do not have permission to change these settings."
msgstr "இந்த அமைப்புகளை மாற்ற உங்களுக்கு அனுமதி இல்லை."

#: includes/class-zinn-offload-admin-ui.php:715
msgid "Settings sections"
msgstr "அமைப்புப் பிரிவுகள்"

#: includes/class-zinn-offload-admin-ui.php:788
msgid "Support"
msgstr "ஆதரவு"

#: includes/class-zinn-offload-admin-ui.php:846
msgid "Save changes"
msgstr "மாற்றங்களைச் சேமிக்கவும்"

#: includes/class-zinn-offload-admin-ui.php:875
msgid "Tools"
msgstr "கருவிகள்"

#: includes/class-zinn-offload-admin-ui.php:890
msgid "Export settings"
msgstr "அமைப்புகளை ஏற்றுமதி செய்"

#: includes/class-zinn-offload-admin-ui.php:893
msgid "Reset to defaults"
msgstr "இயல்புநிலைகளுக்கு மீட்டமைக்கவும்"

#: includes/class-zinn-offload-admin-ui.php:894
msgid "This puts every setting on this plugin back to its default. Continue?"
msgstr "இந்த செருகுநிரலின் ஒவ்வொரு அமைப்பையும் அதன் இயல்புநிலைக்கு மாற்றுகிறது. தொடர வேண்டுமா?"

#: includes/class-zinn-offload-admin-ui.php:901
msgid "Diagnostics for support"
msgstr "ஆதரவுக்கான கண்டறிதல்கள்"

#: includes/class-zinn-offload-admin-ui.php:910
msgid "Import a settings file"
msgstr "அமைப்புகள் கோப்பை இறக்குமதி செய்"

#: includes/class-zinn-offload-admin-ui.php:912
msgid "Import"
msgstr "இறக்குமதி செய்"

#: includes/class-zinn-offload-admin-ui.php:914
msgid "Exported files never contain passwords, tokens or API keys — you will need to enter those again on the new site."
msgstr "ஏற்றுமதி செய்யப்பட்ட கோப்புகளில் கடவுச்சொற்கள், டோக்கன்கள் அல்லது ஏபிஐ விசைகள் (API keys) எப்போதுமே இருக்காது — புதிய தளத்தில் அவற்றை நீங்கள் மீண்டும் உள்ளிட வேண்டும்."

#: includes/class-zinn-offload-admin-ui.php:1013
msgid "Settings saved."
msgstr "அமைப்புகள் சேமிக்கப்பட்டன."

#: includes/class-zinn-offload-admin-ui.php:1060
msgid "Every setting on this plugin is back to its default."
msgstr "இந்த செருகுநிரலில் உள்ள ஒவ்வொரு அமைப்பும் அதன் இயல்புநிலைக்குத் திரும்பியுள்ளது."

#: includes/class-zinn-offload-admin-ui.php:1103
msgid "Done."
msgstr "முடிந்தது."

#: includes/class-zinn-offload-admin-ui.php:1107
msgid "That action is not available."
msgstr "அந்தச் செயல் கிடைக்கவில்லை."

#: includes/class-zinn-offload-admin-ui.php:1174
msgid "That file could not be read. Choose a settings file exported from a Zinn® plugin."
msgstr "அந்தக் கோப்பைப் படிக்க முடியவில்லை. Zinn® செருகுநிரலில் இருந்து ஏற்றுமதி செய்யப்பட்ட அமைப்புக் கோப்பைத் தேர்ந்தெடுக்கவும்."

#: includes/class-zinn-offload-admin-ui.php:1182
msgid "That file is too large to be a settings export."
msgstr "அந்தக் கோப்பு அமைப்புகளின் ஏற்றுமதிக்கு மிகவும் பெரியது."

#: includes/class-zinn-offload-admin-ui.php:1195
msgid "That file is not a Zinn® settings export."
msgstr "அந்தக் கோப்பு ஒரு Zinn® அமைப்புகளின் ஏற்றுமதி அல்ல."

#. translators: %s: the plugin slug the file was exported from.
#: includes/class-zinn-offload-admin-ui.php:1203
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "அந்தக் கோப்பு வேறு செருகுநிரலிலிருந்து (%s) ஏற்றுமதி செய்யப்பட்டது, எனவே அதை இங்கே இறக்குமதி செய்வது இந்தச் செருகுநிரலுக்குப் புரியாத அமைப்புகளைச் சேமிக்கும்."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-offload-admin-ui.php:1233
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d அமைப்பு இறக்குமதி செய்யப்பட்டது. கடவுச்சொற்களும் API விசைகளும் ஒருபோதும் ஏற்றுமதியில் இருக்காது, எனவே அவற்றை மீண்டும் உள்ளிடவும்."
msgstr[1] "%d அமைப்புகள் இறக்குமதி செய்யப்பட்டன. கடவுச்சொற்களும் API சாவிகளும் ஒருபோதும் ஏற்றுமதியில் இருக்காது, எனவே அவற்றை மீண்டும் உள்ளிடவும்."

#: includes/class-zinn-offload-client.php:97
msgid "Zinn Digital® did not return a token. Nothing has been changed on this site."
msgstr "Zinn Digital® டோக்கனை வழங்கவில்லை. இந்தத் தளத்தில் எதுவும் மாற்றப்படவில்லை."

#: includes/class-zinn-offload-client.php:236
msgid "This site is no longer connected to Zinn® media offload. New uploads will stay on this server. Pair it again from your Zinn Digital® dashboard."
msgstr "இந்தத் தளம் இனி Zinn® மீடியா ஆஃப்லோடுடன் இணைக்கப்படவில்லை. புதிய பதிவேற்றங்கள் இந்தச் சேவையகத்தில Zinn Digital® டாஷ்போர்டிலிருந்து இதை மீண்டும் இணைக்கவும்."

#. translators: %d: HTTP status code returned by the Zinn Digital API.
#: includes/class-zinn-offload-client.php:244
#, php-format
msgid "Zinn Digital® answered with HTTP %d."
msgstr "Zinn Digital® HTTP %d உடன் பதிலளித்தது."

#: includes/class-zinn-offload-client.php:262
msgid "Disconnected by Zinn Digital®."
msgstr "Zinn Digital® இலிருந்து துண்டிக்கப்பட்டது."

#: includes/class-zinn-offload-connection.php:58
msgid "Connected"
msgstr "இணைக்கப்பட்டுள்ளது"

#: includes/class-zinn-offload-connection.php:60
msgid "Connecting…"
msgstr "இணைக்கிறது…"

#: includes/class-zinn-offload-connection.php:62
msgid "Connected, but something needs attention"
msgstr "இணைக்கப்பட்டுள்ளது, ஆனால் எதையோ கவனிக்க வேண்டும்"

#: includes/class-zinn-offload-connection.php:64
msgid "Not connected"
msgstr "இணைக்கப்படவில்லை"

#: includes/class-zinn-offload-connection.php:66
msgid "Running on your own account"
msgstr "உங்கள் சொந்த கணக்கில் இயங்குகிறது"

#: includes/class-zinn-offload-connection.php:68
msgid "We could not check this"
msgstr "இதைச் சரிபார்க்க முடியவில்லை"

#: includes/class-zinn-offload-connection.php:93
msgid "This plugin did not say why. Send a diagnostics report and we will look."
msgstr "இந்த செருகுநிறைக்கான காரணம் தெரிவிக்கப்படவில்லை. கண்டறிதல் அறிக்கையை அனுப்பவும், நாங்கள் பரிசீலிக்கிறோம்."

#: includes/class-zinn-offload-connection.php:161
msgid "Connection status"
msgstr "இணைப்பு நிலை"

#. translators: %s: a human-readable interval such as "5 minutes".
#: includes/class-zinn-offload-connection.php:189
#, php-format
msgid "Last checked %s ago."
msgstr "கடைசியாக %s முன்பு சரிபார்க்கப்பட்டது."

#: includes/class-zinn-offload-connection.php:251
msgid "(opens in a new tab)"
msgstr "(புதிய தாவலில் திறக்கும்)"

#: includes/class-zinn-offload-diagnostics.php:199
msgid "Send this to Zinn® support"
msgstr "இதனை Zinn® ஆதரவுப் பகுதிக்கு அனுப்பவும்"

#: includes/class-zinn-offload-diagnostics.php:201
msgid "This is exactly what will be sent — nothing else, and nothing hidden. Your passwords, tokens and API keys are not in it."
msgstr "இதுதான் சரியாக அனுப்பப்படும் — வேறு எதுவும் இல்லை, மறைக்கப்பட்டதும் இல்லை. உங்கள் கடவுச்சொற்கள், டோக்கன்கள் மற்றும் API விசைகள் இதில் இல்லை."

#: includes/class-zinn-offload-diagnostics.php:204
msgid "The diagnostics report that will be sent"
msgstr "அனுப்பப்படவுள்ள கண்டறிதல் அறிக்கை"

#: includes/class-zinn-offload-diagnostics.php:207
msgid "Copy to clipboard"
msgstr "கிளிப் போர்டுக்கு நகலெடு"

#: includes/class-zinn-offload-diagnostics.php:214
msgid "Send this report to Zinn® support"
msgstr "இந்த அறிக்கையை Zinn® ஆதரவுக் குழுவிற்கு அனுப்பவும்"

#: includes/class-zinn-offload-diagnostics.php:216
msgid "We open a support ticket for you and reply by email. If you would rather not send it, copy it above and paste it into a ticket yourself."
msgstr "நாங்கள் உங்களுக்காக ஒரு ஆதரவுச் சீட்டைத் திறந்து, மின்னஞ்சல் மூலம் பதிலளிப்போம். இதை அனுப்ப விரும்பவில்லை எனில், மேலே உள்ளதை நகலெடுத்து நீங்களே ஒரு சீட்டில் ஒட்டவும்."

#: includes/class-zinn-offload-diagnostics.php:228
msgid "Copied"
msgstr "நகலெடுக்கப்பட்டது"

#. translators: %s: the transport error reported by WordPress.
#: includes/class-zinn-offload-diagnostics.php:274
#, php-format
msgid "We could not reach Zinn Digital® from this server (%s). Copy the report above and open a ticket instead — nothing about your settings is wrong."
msgstr "இந்தச் சேவையகத்திலிருந்து (%s) Zinn Digital®-ஐ எங்களால் அடைய முடியவில்லை. மேலே உள்ள அறிக்கையை நகலெடுத்து அதற்குப் பதிலாக ஒரு டிக்கைத் திறக்கவும் — உங்கள் அமைப்புகளில் எதுவும் தவறில்லை."

#: includes/class-zinn-offload-diagnostics.php:288
msgid "Sent. Zinn® support has your report and will reply by email."
msgstr "Zinn® ஆதரவு உங்கள் அறிக்கையைப் பெற்றுள்ளது, மேலும் மின்னஞ்சல் மூலம் பதிலளிக்கும்."

#. translators: %s: the support reference for the report just sent.
#: includes/class-zinn-offload-diagnostics.php:291
#, php-format
msgid "Sent. Zinn® support has your report — reference %s — and will reply by email."
msgstr "உங்கள் Zinn® ஆதரவுப் பிரிவு உங்கள் அறிக்கையைப் பெற்றுள்ளது — குறிப்பு %s — மேலும் மின்னஞ்சல் மூலம் பதிலளிக்கும்."

#: includes/class-zinn-offload-diagnostics.php:300
msgid "You have sent several reports in a short time. Wait a few minutes and try again — the earlier ones did arrive."
msgstr "நீங்கள் குறுகிய காலத்தில் பல அறிக்கைகளை அனுப்பியுள்ளீர்கள். சில நிமிடங்கள் காத்திருந்து மீண்டும் முயற்சிக்கவும் — முந்தையவை வந்து சேர்ந்துவிட்டன."

#: includes/class-zinn-offload-diagnostics.php:307
msgid "Zinn Digital® could not accept the report just now — that is our end, not yours. Try again shortly, or copy the report above into a ticket."
msgstr "Zinn Digital® தற்சமயம் அறிக்கையை ஏற்றுக்கொள்ள முடியவில்லை — இது உங்கள் தரப்புப் பிழை அல்ல, எங்கள் தரப்புப் பிழை. சிறிது நேரத்திற்குப் பிறகு மீண்டும் முயற்சிக்கவும் அல்லது மேலே உள்ள அறிக்கையை ஒரு டிக்கெட்டில் நகலெடுக்கவும்."

#. translators: %d: the HTTP status code the server returned.
#: includes/class-zinn-offload-diagnostics.php:315
#, php-format
msgid "The report was refused (HTTP %d). Copy it above and open a ticket, quoting that number."
msgstr "அறிக்கை மறுக்கப்பட்டது (HTTP %d). அதை மேலே நகலெடுத்து, அந்த எண்ணைக் குறிப்பிட்டு ஒரு டிக்கெட்டைத் திறக்கவும்."

#. translators: %s: the Zinn Digital trade mark, which is not translated.
#: includes/class-zinn-offload-promo.php:241
