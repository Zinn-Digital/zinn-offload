msgstr "Všechna nastavení tohoto pluginu byla vrácena na výchozí hodnoty."

#: includes/class-zinn-offload-admin-ui.php:1103
msgid "Done."
msgstr "Hotovo."

#: includes/class-zinn-offload-admin-ui.php:1107
