#. Plugin Name of the plugin
#: zinn-offload.php
#: includes/class-zinn-offload-settings.php:63
#: includes/class-zinn-offload-settings.php:64
#: includes/class-zinn-offload-settings.php:86
msgid "Zinn® Media Offload"
msgstr "Zinn® Media Offload"

#. Plugin URI of the plugin
#: zinn-offload.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-offload"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-offload"

#. Description of the plugin
#: zinn-offload.php
msgid "Moves this site's media library to Zinn® object storage and serves it from a CDN. Configured from your Zinn® dashboard — no access key is ever typed into WordPress."
msgstr "Mută biblioteca media a acestui site în stocarea de obiecte Zinn® și o servește dintr-un CDN. Configurat din panoul de control Zinn® — nicio cheie de acces nu este tastată vreodată în WordPress."

#. Author of the plugin
#: zinn-offload.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-offload.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-zinn-offload-client.php:97
msgid "Zinn Digital® did not return a token. Nothing has been changed on this site."
msgstr "Zinn Digital® nu a returnat niciun token. Nimic nu a fost modificat pe acest site."

#: includes/class-zinn-offload-client.php:157
#: includes/class-zinn-offload-client.php:165
msgid "That file could not be read from this server, so nothing was uploaded."
msgstr "Fișierul nu a putut fi citit de pe acest server, așa că nu s-a încărcat nimic."

#. translators: %d: HTTP status code returned by the storage service.
#: includes/class-zinn-offload-client.php:191
#, php-format
msgid "Storage refused the upload (HTTP %d). The file is still on this server."
msgstr "Stocarea a refuzat încărcarea (HTTP %d). Fișierul se află în continuare pe acest server."

#: includes/class-zinn-offload-client.php:272
msgid "This site is no longer connected to Zinn® media offload. New uploads will stay on this server. Pair it again from your Zinn Digital® dashboard."
msgstr "Acest site nu mai este conectat la descărcarea media Zinn®. Noile încărcări vor rămâne pe acest server. Asociați-l din nou din panoul de control Zinn Digital®."

#. translators: %d: HTTP status code returned by the Zinn Digital API.
#: includes/class-zinn-offload-client.php:280
#, php-format
msgid "Zinn Digital® answered with HTTP %d."
msgstr "Zinn Digital® a răspuns cu HTTP %d."

#: includes/class-zinn-offload-client.php:298
msgid "Disconnected by Zinn Digital®."
msgstr "Deconectat de Zinn Digital®."

#. translators: %s: the Zinn Digital trade mark, which is not translated.
#: includes/class-zinn-offload-promo.php:241
#: includes/class-zinn-offload-promo.php:299
#, php-format
msgid "%s — guides and services"
msgstr "%s — ghiduri și servicii"

#: includes/class-zinn-offload-promo.php:256
msgid "User guides"
msgstr "Ghiduri de utilizare"

#. translators: %s: this plugin's name, e.g. "Zinn® Cache".
#: includes/class-zinn-offload-promo.php:306
#, php-format
msgid "Read the %s user guide"
msgstr "Citește ghidul de utilizator %s"

#: includes/class-zinn-offload-promo.php:314
msgid "Hide this"
msgstr "Ascunde aceasta"

#: includes/class-zinn-offload-promo.php:374
msgid "Zinn® hosting for WordPress"
msgstr "Găzduire Zinn® pentru WordPress"

#: includes/class-zinn-offload-promo.php:375
msgid "LiteSpeed, daily backups, free migration and a control panel built for people who run more than one site."
msgstr "LiteSpeed, copii de rezervă zilnice, migrare gratuită și un panou de control conceput pentru cei care administrează mai multe site-uri."

#: includes/class-zinn-offload-promo.php:381
msgid "The Zinn® marketplace"
msgstr "Piața Zinn®"

#: includes/class-zinn-offload-promo.php:382
msgid "Buy and sell established sites, domains and link placements, with the money held safely until both sides are happy."
msgstr "Cumpărați și vindeți site-uri, domenii și plasări de linkuri existente, banii fiind păstrați în siguranță până când ambele părți sunt mulțumite."

#: includes/class-zinn-offload-promo.php:429
msgid "Zinn Hub® — hire people who do this for a living"
msgstr "Zinn Hub® — angajați oameni care fac asta pentru a trăi"

#: includes/class-zinn-offload-promo.php:430
msgid "Our global freelance marketplace: browse over 10,000 ready-made services from writers, designers, developers and SEOs, or post a project and let them bid."
msgstr "Piața noastră globală de freelancing: căutați printre peste 10.000 de servicii gata făcute de la scriitori, designeri, dezvoltatori și specialiști SEO, sau postați un proiect și lăsați-i să liciteze."

#: includes/class-zinn-offload-settings.php:78
#: includes/class-zinn-offload-settings.php:223
#: includes/class-zinn-offload-settings.php:256
msgid "You do not have permission to manage this site."
msgstr "Nu aveți permisiunea de a gestiona acest site."

#: includes/class-zinn-offload-settings.php:93
msgid "Open your Zinn Digital® dashboard, turn on media offload for this site, and paste the pairing code it shows you. No access key is needed — this site never holds one."
msgstr "Deschideți panoul de control Zinn Digital®, activați descărcarea conținutului multimedia pentru acest site și introduceți codul de asociere afișat. Nu este necesară nicio cheie de acces — acest site nu deține niciuna."

#: includes/class-zinn-offload-settings.php:103
msgid "Pairing code"
msgstr "Cod de asociere"

#: includes/class-zinn-offload-settings.php:114
msgid "Connect this site"
msgstr "Conectează acest site"

#: includes/class-zinn-offload-settings.php:120
msgid "Status"
msgstr "Stare"

#: includes/class-zinn-offload-settings.php:121
msgid "Connected to your Zinn Digital® account"
msgstr "Conectat la contul dvs. Zinn Digital®"

#: includes/class-zinn-offload-settings.php:124
msgid "Media served from"
msgstr "Conținut multimedia livrat de la"

#: includes/class-zinn-offload-settings.php:129
msgid "This server (offloaded copies are being kept, but not served yet)"
msgstr "Acest server (se păstrează copii descărcate, dar nu sunt încă livrate)"

#: includes/class-zinn-offload-settings.php:134
msgid "Local copies"
msgstr "Copii locale"

#: includes/class-zinn-offload-settings.php:138
msgid "Removed once every size has uploaded"
msgstr "Eliminat după ce fiecare dimensiune a fost încărcată"

#: includes/class-zinn-offload-settings.php:139
msgid "Kept on this server"
msgstr "Păstrat pe acest server"

#: includes/class-zinn-offload-settings.php:144
msgid "Offloaded so far"
msgstr "Descărcat până acum"

#. translators: 1: number of files, 2: human-readable size.
#: includes/class-zinn-offload-settings.php:149
#, php-format
msgid "%1$s files, %2$s"
msgstr "%1$s fișiere, %2$s"

#: includes/class-zinn-offload-settings.php:157
msgid "Still on this server"
msgstr "Încă pe acest server"

#. translators: 1: attachments not yet offloaded, 2: total attachments.
#: includes/class-zinn-offload-settings.php:167
#, php-format
msgid "%1$s of %2$s attachments"
msgstr "%1$s din %2$s atașamente"

#: includes/class-zinn-offload-settings.php:174
msgid "Older media moves in the background, a few files an hour, and picks up where it left off. Nothing is deleted from this server unless your dashboard says so."
msgstr "Fișierele media mai vechi sunt transferate în fundal, câteva fișiere pe oră, și procesul este reluat de unde a fost întrerupt. Nimic nu este șters de pe acest server decât dacă panoul de control indică acest lucru."

#: includes/class-zinn-offload-settings.php:184
msgid "Last problem"
msgstr "Ultima problemă"

#: includes/class-zinn-offload-settings.php:194
msgid "Disconnect this site"
msgstr "Deconectați acest site"

#: includes/class-zinn-offload-settings.php:197
msgid "New uploads will stay on this server. Media already moved keeps working — its address does not change."
msgstr "Noile încărcări vor rămâne pe acest server. Conținutul multimedia mutat deja continuă să funcționeze — adresa lui nu se schimbă."

#: includes/class-zinn-offload-settings.php:231
msgid "Paste the pairing code from your Zinn Digital® dashboard."
msgstr "Lipiți codul de asociere din panoul de control Zinn Digital®."

#: includes/class-zinn-offload-settings.php:240
msgid "Connected. New uploads will be stored with Zinn Digital® from now on, and your existing media will move in the background."
msgstr "Conectat. Noile încărcări vor fi stocate începând de acum cu Zinn Digital®, iar conținutul media existent va fi mutat în fundal."

#: includes/class-zinn-offload-settings.php:268
msgid "Disconnected. Media already moved keeps working; new uploads stay on this server."
msgstr "Deconectat. Conținutul media mutat deja funcționează în continuare; încărcările noi rămân pe acest server."
