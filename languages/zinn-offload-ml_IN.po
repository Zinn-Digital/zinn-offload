msgstr "%s — വഴികാട്ടികളും സേവനങ്ങളും"

#: includes/class-zinn-offload-promo.php:341
msgid "User guides"
msgstr "ഉപയോക്തൃ ഗൈഡുകൾ"

#. translators: %s: this plugin's name, e.g. "Zinn® Cache".
#: includes/class-zinn-offload-promo.php:391
#, php-format
